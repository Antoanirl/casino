# Copy this file to .env and fill in the values. Never commit .env or .env.local.
# (.env, not .env.local: the Prisma CLI only reads .env. Next.js reads both.)

# Public URL of the app (used for metadata and absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Neon). Copy both from the Neon console or Vercel → Settings → Environment Variables.
# Pooled connection, used by the app:
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct connection, used by migrations:
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: a THROWAWAY database for `npm run test:db`. Every test run deletes all its rows.
# CI provides its own, so you only need this to run the database tests locally.
# DATABASE_URL_TEST=

